{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Keep this secret configured in the Cloudflare Worker settings. It must be
  // the same 64-hex key used when the existing member login codes were made.
  // `keep_vars` preserves it when this file is deployed from GitHub.
  "name": "empire-bowls-club",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [
    {
      "pattern": "empirebowlsclub.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.empirebowlsclub.co.uk",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "empire-bowls-club-data",
      "database_id": "b80c005e-f9db-4753-8ade-5672de22eadf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "empire-bowls-club-assets"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  }
}
